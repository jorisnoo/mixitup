{
  "name": "mixitup",
  "title": "MixItUp",
  "version": "4.0.2",
  "type": "module",
  "description": "A high-performance, dependency-free library for animated filtering, sorting and more",
  "author": "KunkaLabs Limited",
  "license": "Apache-2.0",
  "main": "./dist/mixitup.js",
  "module": "./dist/mixitup.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/mixitup.js"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "https://github.com/jorisnoo/mixitup/"
  },
  "scripts": {
    "build": "vite build",
    "check:types": "tsc --noEmit && tsc -p tests/types",
    "check": "npm audit && npm run build && npm run check:types && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "@microsoft/api-extractor@7.60.1": {
      "minimatch": "^11.0.8"
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.1",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
